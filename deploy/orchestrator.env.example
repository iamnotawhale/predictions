# cp deploy/orchestrator.env.example deploy/orchestrator.env на VPS (gitignore)
# Оркестратор живёт на VPS, не на Odyssey.

# Сколько подряд failed/ok проверок до действия
FAILURES_BEFORE_FAILOVER=3
SUCCESSES_BEFORE_FAILBACK=3

# Автодействия (false = только Telegram-алерты)
AUTO_FAILOVER=true
AUTO_FAILBACK=true

# Odyssey WAN (обновляется backup-to-vps → odyssey-endpoint.env; эти — fallback)
ODYSSEY_SSH_USER=nikita
ODYSSEY_SSH_PORT=2222
ODYSSEY_HTTPS_PORT=8443

APP_DIR=/home/predictions
BACKUP_DIR=/var/backups/predictions
STATE_DIR=/var/lib/predictions-orchestrator
LOG_FILE=/home/predictions/logs/orchestrator.log
