# Скопируйте: cp deploy/predicts.env.example deploy/predicts.env

# === Продакшен (Caddy + Let's Encrypt) ===
# DNS домена должен указывать на сервер. Порты 80 и 443 открыты.
PUBLIC_DOMAIN=predicts.example.com
PUBLIC_HTTPS_URL=https://predicts.example.com
BOT_WEBAPP_URL=https://predicts.example.com/miniapp/
APP_PORT=8080

# === Локально (не коммитить predicts.env с trycloudflare) ===
# Запустите: ./scripts/dev-https.sh
# URL попадёт в deploy/local-https.env (генерируется автоматически)
