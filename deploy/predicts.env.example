# Продакшен: cp deploy/predicts.env.example deploy/predicts.env && заполните секреты
# Файл deploy/predicts.env в .gitignore

SPRING_PROFILES_ACTIVE=prod

# Telegram (@eplinfobot)
BOT_USERNAME=eplinfobot
BOT_TOKEN=
BOT_CHAT_ID=-1001762896029

# Админ для panic-уведомлений (личный chat id)
ADMIN_CHAT_ID=739299

# БД (пароль postgres на сервере; url задаётся в application-prod.yml)
SPRING_DATASOURCE_PASSWORD=postgres

# API-Football
API_FOOTBALL_TOKEN=

# Mini App (Caddy или cloudflared)
PUBLIC_DOMAIN=predicts.example.com
PUBLIC_HTTPS_URL=https://predicts.example.com
BOT_WEBAPP_URL=https://predicts.example.com/miniapp/
APP_PORT=8080
