# Продакшен: cp deploy/predicts.env.example deploy/predicts.env && заполните секреты
# Файл deploy/predicts.env в .gitignore
# systemd: EnvironmentFile=-.../deploy/predicts.env
# Соответствует placeholders в application.yml (+ override URL в application-prod.yml)

SPRING_PROFILES_ACTIVE=prod

# ${BOT_USERNAME:} / ${BOT_TOKEN:} / ${BOT_CHAT_ID:}
BOT_USERNAME=
BOT_TOKEN=
BOT_CHAT_ID=

# ${ADMIN_CHAT_ID:} → property chatId (panic + admin-команды)
ADMIN_CHAT_ID=

# ${SPRING_DATASOURCE_PASSWORD:} (url/user по умолчанию из application-prod.yml)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/predicts_prod
SPRING_DATASOURCE_PASSWORD=

# ${API_FOOTBALL_TOKEN:}
API_FOOTBALL_TOKEN=

# ${BOT_WEBAPP_URL:} + вспомогательные для Caddy/DynDNS (не Spring)
# PUBLIC_DOMAIN=
# PUBLIC_HTTPS_URL=
# BOT_WEBAPP_URL=
# HTTPS_PORT=443
APP_PORT=8080
