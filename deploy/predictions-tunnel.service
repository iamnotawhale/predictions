[Unit]
Description=Cloudflare quick tunnel for Predictions Mini App
After=network-online.target predicts.service
Wants=predicts.service

[Service]
Type=simple
User=REPLACE_USER
Group=REPLACE_USER
Environment=APP_DIR=/path/to/predictions
Environment=HOME=/home/REPLACE_USER
ExecStart=/usr/bin/cloudflared tunnel --protocol http2 --url http://127.0.0.1:8080
ExecStartPost=/bin/sleep 6
ExecStartPost=/path/to/predictions/deploy/sync-tunnel-env.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
