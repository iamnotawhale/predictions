# cp deploy/deploy.env.example deploy/deploy.env && заполните (файл в .gitignore)
# Читает deploy/upload-jar.sh

# user@host для scp/ssh
DEPLOY_SERVER=user@your-prod-host
# абсолютный путь к приложению на сервере (подставляется в systemd unit)
DEPLOY_APP_DIR=/path/to/predictions
# На хосте с sudo для systemctl: DEPLOY_REMOTE_SUDO=sudo
# На root без sudo: оставьте пустым или DEPLOY_REMOTE_SUDO=
DEPLOY_REMOTE_SUDO=sudo
